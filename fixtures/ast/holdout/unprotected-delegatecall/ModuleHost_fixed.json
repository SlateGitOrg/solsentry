nces;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    function execute(address module, bytes calldata payload) external payable returns (bytes memory) {\n        require(msg.sender == owner, \"owner\");\n        (bool ok, bytes memory ret) = module.delegatecall(payload);\n        require(ok, \"module failed\");\n        return ret;\n    }\n}\n","id":0}}}
