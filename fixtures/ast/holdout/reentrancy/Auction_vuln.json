e":"highestBid","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5,"src":"789:10:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"expression":{"id":67,"name":"msg","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":-15,"src":"802:3:0","typeDescriptions":{"typeIdentifier":"t_magic_message","typeString":"msg"}},"id":68,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"806:5:0","memberName":"value","nodeType":"MemberAccess","src":"802:9:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"789:22:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"id":70,"nodeType":"ExpressionStatement","src":"789:22:0"}]},"functionSelector":"1998aeef","id":72,"implemented":true,"kind":"function","modifiers":[],"name":"bid","nameLocation":"431:3:0","nodeType":"FunctionDefinition","parameters":{"id":21,"nodeType":"ParameterList","parameters":[],"src":"434:2:0"},"returnParameters":{"id":22,"nodeType":"ParameterList","parameters":[],"src":"454:0:0"},"scope":73,"src":"422:396:0","stateMutability":"payable","virtual":false,"visibility":"external"}],"scope":74,"src":"192:628:0","usedErrors":[],"usedEvents":[]}],"src":"166:655:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture (intentionally vulnerable): refunding the previous bidder with a raw call\n// before recording the new highest bid.\npragma solidity ^0.8.20;\n\ncontract Auction {\n    address payable public highestBidder;\n    uint256 public highestBid;\n    uint256 public immutable endTime;\n\n    constructor(uint256 biddingTime) {\n        endTime = block.timestamp + biddingTime;\n    }\n\n    function bid() external payable {\n        require(block.timestamp < endTime, \"ended\");\n        require(msg.value > highestBid, \"too low\");\n        if (highestBid != 0) {\n            (bool ok, ) = highestBidder.call{value: highestBid}(\"\"); // @expect: reentrancy\n            require(ok, \"refund failed\");\n        }\n        highestBidder = payable(msg.sender);\n        highestBid = msg.value;\n    }\n}\n","id":0}}}
