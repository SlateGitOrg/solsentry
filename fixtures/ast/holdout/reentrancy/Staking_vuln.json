"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"970:16:0"},"returnParameters":{"id":91,"nodeType":"ParameterList","parameters":[],"src":"996:0:0"},"scope":137,"src":"954:268:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"body":{"id":135,"nodeType":"Block","src":"1290:35:0","statements":[{"expression":{"baseExpression":{"id":131,"name":"stakes","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":36,"src":"1307:6:0","typeDescriptions":{"typeIdentifier":"t_mapping$_t_address_$_t_uint256_$","typeString":"mapping(address => uint256)"}},"id":133,"indexExpression":{"id":132,"name":"who","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":126,"src":"1314:3:0","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"nodeType":"IndexAccess","src":"1307:11:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"functionReturnParameters":130,"id":134,"nodeType":"Return","src":"1300:18:0"}]},"functionSelector":"42623360","id":136,"implemented":true,"kind":"function","modifiers":[],"name":"stakeOf","nameLocation":"1237:7:0","nodeType":"FunctionDefinition","parameters":{"id":127,"nodeType":"ParameterList","parameters":[{"constant":false,"id":126,"mutability":"mutable","name":"who","nameLocation":"1253:3:0","nodeType":"VariableDeclaration","scope":136,"src":"1245:11:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":125,"name":"address","nodeType":"ElementaryTypeName","src":"1245:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"1244:13:0"},"returnParameters":{"id":130,"nodeType":"ParameterList","parameters":[{"constant":false,"id":129,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":136,"src":"1281:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":128,"name":"uint256","nodeType":"ElementaryTypeName","src":"1281:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"1280:9:0"},"scope":137,"src":"1228:97:0","stateMutability":"view","virtual":false,"visibility":"external"}],"scope":138,"src":"471:856:0","usedErrors":[],"usedEvents":[]}],"src":"186:1142:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture (intentionally vulnerable): token callbacks (ERC-777 style hooks) can\n// re-enter both entry points before the bookkeeping is updated.\npragma solidity ^0.8.20;\n\ninterface IERC20 {\n    function transfer(address to, uint256 amount) external returns (bool);\n    function transferFrom(address from, address to, uint256 amount) external returns (bool);\n    function balanceOf(address who) external view returns (uint256);\n}\n\ncontract Staking {\n    IERC20 public immutable token;\n    mapping(address => uint256) public stakes;\n    uint256 public totalStaked;\n\n    constructor(IERC20 stakingToken) {\n        token = stakingToken;\n    }\n\n    function stake(uint256 amount) external {\n        require(amount > 0, \"zero\");\n        require(token.transferFrom(msg.sender, address(this), amount), \"pull failed\"); // @expect: reentrancy\n        stakes[msg.sender] += amount;\n        totalStaked += amount;\n    }\n\n    function unstake(uint256 amount) external {\n        require(stakes[msg.sender] >= amount, \"too much\");\n        require(token.transfer(msg.sender, amount), \"push failed\"); // @expect: reentrancy\n        stakes[msg.sender] -= amount;\n        totalStaked -= amount;\n    }\n\n    function stakeOf(address who) external view returns (uint256) {\n        return stakes[who];\n    }\n}\n","id":0}}}
