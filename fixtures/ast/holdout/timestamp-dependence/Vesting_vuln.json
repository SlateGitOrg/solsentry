16:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"1099:35:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"id":124,"nodeType":"IfStatement","src":"1095:115:0","trueBody":{"id":123,"nodeType":"Block","src":"1136:74:0","statements":[{"expression":{"id":121,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftHandSide":{"id":119,"name":"bonusPaid","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":13,"src":"1183:9:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"hexValue":"74727565","id":120,"isConstant":false,"isLValue":false,"isPure":true,"kind":"bool","lValueRequested":false,"nodeType":"Literal","src":"1195:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"value":"true"},"src":"1183:16:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"id":122,"nodeType":"ExpressionStatement","src":"1183:16:0"}]}}]},"functionSelector":"50635394","id":126,"implemented":true,"kind":"function","modifiers":[],"name":"claimBonus","nameLocation":"1026:10:0","nodeType":"FunctionDefinition","parameters":{"id":105,"nodeType":"ParameterList","parameters":[],"src":"1036:2:0"},"returnParameters":{"id":106,"nodeType":"ParameterList","parameters":[],"src":"1048:0:0"},"scope":127,"src":"1017:199:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":128,"src":"146:1072:0","usedErrors":[],"usedEvents":[]}],"src":"120:1099:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture (intentionally vulnerable): the bonus only pays at one exact second.\npragma solidity ^0.8.20;\n\ncontract Vesting {\n    uint256 public immutable start;\n    uint256 public immutable cliff;\n    uint256 public immutable duration;\n    address public immutable beneficiary;\n    uint256 public released;\n    bool public bonusPaid;\n\n    constructor(address who, uint256 cliffSeconds, uint256 durationSeconds) payable {\n        beneficiary = who;\n        start = block.timestamp;\n        cliff = block.timestamp + cliffSeconds;\n        duration = durationSeconds;\n    }\n\n    function release() external {\n        require(block.timestamp >= cliff, \"cliff\");\n        uint256 vested = address(this).balance + released;\n        if (block.timestamp < start + duration) {\n            vested = (vested * (block.timestamp - start)) / duration;\n        }\n        uint256 amount = vested - released;\n        released += amount;\n        payable(beneficiary).transfer(amount);\n    }\n\n    function claimBonus() external {\n        require(!bonusPaid, \"paid\");\n        if (block.timestamp == start + duration) { // @expect: timestamp-dependence\n            bonusPaid = true;\n        }\n    }\n}\n","id":0}}}
