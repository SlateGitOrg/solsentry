e","typeString":"msg"}},"id":107,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"940:6:0","memberName":"sender","nodeType":"MemberAccess","src":"936:10:0","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":true,"nodeType":"IndexAccess","src":"931:16:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"Assignment","operator":"+=","rightHandSide":{"hexValue":"31","id":109,"isConstant":false,"isLValue":false,"isPure":true,"kind":"number","lValueRequested":false,"nodeType":"Literal","src":"951:1:0","typeDescriptions":{"typeIdentifier":"t_rational_1_by_1","typeString":"int_const 1"},"value":"1"},"src":"931:21:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"id":111,"nodeType":"ExpressionStatement","src":"931:21:0"}]}}]},"functionSelector":"a6af9822","id":115,"implemented":true,"kind":"function","modifiers":[],"name":"reveal","nameLocation":"494:6:0","nodeType":"FunctionDefinition","parameters":{"id":37,"nodeType":"ParameterList","parameters":[{"constant":false,"id":34,"mutability":"mutable","name":"guess","nameLocation":"506:5:0","nodeType":"VariableDeclaration","scope":115,"src":"501:10:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":33,"name":"bool","nodeType":"ElementaryTypeName","src":"501:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"},{"constant":false,"id":36,"mutability":"mutable","name":"secret","nameLocation":"521:6:0","nodeType":"VariableDeclaration","scope":115,"src":"513:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"},"typeName":{"id":35,"name":"bytes32","nodeType":"ElementaryTypeName","src":"513:7:0","typeDescriptions":{"typeIdentifier":"t_bytes32","typeString":"bytes32"}},"visibility":"internal"}],"src":"500:28:0"},"returnParameters":{"id":38,"nodeType":"ParameterList","parameters":[],"src":"538:0:0"},"scope":116,"src":"485:484:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":117,"src":"180:791:0","usedErrors":[],"usedEvents":[]}],"src":"154:818:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: commit-reveal; the outcome mixes the player's secret with a future\n// blockhash instead of the clock.\npragma solidity ^0.8.20;\n\ncontract CoinFlip {\n    struct Commit {\n        bytes32 hash;\n        uint256 blockNumber;\n    }\n\n    mapping(address => uint256) public wins;\n    mapping(address => Commit) public commits;\n\n    function commit(bytes32 hash) external {\n        commits[msg.sender] = Commit(hash, block.number);\n    }\n\n    function reveal(bool guess, bytes32 secret) external {\n        Commit memory c = commits[msg.sender];\n        require(c.blockNumber != 0 && block.number > c.blockNumber, \"too early\");\n        require(keccak256(abi.encodePacked(guess, secret)) == c.hash, \"bad reveal\");\n        delete commits[msg.sender];\n        uint256 r = uint256(keccak256(abi.encodePacked(secret, blockhash(c.blockNumber))));\n        if ((r % 2 == 1) == guess) {\n            wins[msg.sender] += 1;\n        }\n    }\n}\n","id":0}}}
