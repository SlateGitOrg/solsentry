n","parameters":{"id":29,"nodeType":"ParameterList","parameters":[{"constant":false,"id":28,"mutability":"mutable","name":"guess","nameLocation":"400:5:0","nodeType":"VariableDeclaration","scope":57,"src":"395:10:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":27,"name":"bool","nodeType":"ElementaryTypeName","src":"395:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"src":"394:12:0"},"returnParameters":{"id":30,"nodeType":"ParameterList","parameters":[],"src":"416:0:0"},"scope":58,"src":"381:212:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":59,"src":"151:444:0","usedErrors":[],"usedEvents":[]}],"src":"125:471:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture (intentionally vulnerable): \"randomness\" from a helper hashing the clock.\npragma solidity ^0.8.20;\n\ncontract CoinFlip {\n    mapping(address => uint256) public wins;\n\n    function _random() internal view returns (uint256) {\n        return uint256(keccak256(abi.encodePacked(block.timestamp, block.number, msg.sender)));\n    }\n\n    function flip(bool guess) external {\n        uint256 r = _random();\n        bool side = r % 2 == 1; // @expect: timestamp-dependence\n        if (side == guess) {\n            wins[msg.sender] += 1;\n        }\n    }\n}\n","id":0}}}
