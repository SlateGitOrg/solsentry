","id":65,"implemented":true,"kind":"function","modifiers":[],"name":"noContracts","nameLocation":"610:11:0","nodeType":"FunctionDefinition","parameters":{"id":54,"nodeType":"ParameterList","parameters":[],"src":"621:2:0"},"returnParameters":{"id":57,"nodeType":"ParameterList","parameters":[{"constant":false,"id":56,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":65,"src":"647:4:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"},"typeName":{"id":55,"name":"bool","nodeType":"ElementaryTypeName","src":"647:4:0","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"visibility":"internal"}],"src":"646:6:0"},"scope":66,"src":"601:99:0","stateMutability":"view","virtual":false,"visibility":"external"}],"scope":67,"src":"115:587:0","usedErrors":[],"usedEvents":[]}],"src":"89:614:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: the helper authenticates msg.sender.\npragma solidity ^0.8.20;\n\ncontract GuardedVault {\n    address public owner;\n    mapping(address => uint256) public allowanceOf;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    function _isAuthorized() internal view returns (bool) {\n        return msg.sender == owner;\n    }\n\n    modifier onlyOwner() {\n        require(_isAuthorized(), \"unauthorized\");\n        _;\n    }\n\n    function setAllowance(address spender, uint256 amount) external onlyOwner {\n        allowanceOf[spender] = amount;\n    }\n\n    function noContracts() external view returns (bool) {\n        return msg.sender == tx.origin;\n    }\n}\n","id":0}}}
