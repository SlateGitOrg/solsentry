"},"scope":80,"src":"482:206:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":81,"src":"124:566:0","usedErrors":[],"usedEvents":[]}],"src":"98:593:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: owner-only sweep; per-user refunds stay open.\npragma solidity ^0.8.20;\n\ncontract Payroll {\n    address public owner;\n    mapping(address => uint256) public refunds;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    receive() external payable {}\n\n    function claimRefund() external {\n        uint256 amount = refunds[msg.sender];\n        refunds[msg.sender] = 0;\n        payable(msg.sender).transfer(amount);\n    }\n\n    function withdraw(address payable to) external {\n        require(msg.sender == owner, \"owner\");\n        (bool ok, ) = to.call{value: address(this).balance}(\"\");\n        require(ok, \"withdraw failed\");\n    }\n}\n","id":0}}}
