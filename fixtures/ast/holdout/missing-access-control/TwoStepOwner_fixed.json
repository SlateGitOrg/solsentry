ess","typeString":"address"},"typeName":{"id":55,"name":"address","nodeType":"ElementaryTypeName","src":"631:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"630:14:0"},"returnParameters":{"id":58,"nodeType":"ParameterList","parameters":[],"src":"654:0:0"},"scope":72,"src":"603:115:0","stateMutability":"nonpayable","virtual":false,"visibility":"internal"}],"scope":73,"src":"114:606:0","usedErrors":[],"usedEvents":[]}],"src":"88:633:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: only the proposed owner may accept.\npragma solidity ^0.8.20;\n\ncontract TwoStepOwner {\n    address public owner;\n    address public pendingOwner;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    modifier onlyOwner() {\n        require(msg.sender == owner, \"owner\");\n        _;\n    }\n\n    function proposeOwner(address next) external onlyOwner {\n        pendingOwner = next;\n    }\n\n    function acceptOwnership() external {\n        require(msg.sender == pendingOwner, \"not pending owner\");\n        _transferOwnership(pendingOwner);\n    }\n\n    function _transferOwnership(address next) internal {\n        owner = next;\n        pendingOwner = address(0);\n    }\n}\n","id":0}}}
