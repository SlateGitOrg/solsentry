,"src":"635:14:0"},"returnParameters":{"id":50,"nodeType":"ParameterList","parameters":[],"src":"659:0:0"},"scope":64,"src":"608:115:0","stateMutability":"nonpayable","virtual":false,"visibility":"internal"}],"scope":65,"src":"150:575:0","usedErrors":[],"usedEvents":[]}],"src":"124:602:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture (intentionally vulnerable): acceptOwnership forgets to check the caller.\npragma solidity ^0.8.20;\n\ncontract TwoStepOwner {\n    address public owner;\n    address public pendingOwner;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    modifier onlyOwner() {\n        require(msg.sender == owner, \"owner\");\n        _;\n    }\n\n    function proposeOwner(address next) external onlyOwner {\n        pendingOwner = next;\n    }\n\n    function acceptOwnership() external {\n        _transferOwnership(pendingOwner); // @expect: missing-access-control\n    }\n\n    function _transferOwnership(address next) internal {\n        owner = next;\n        pendingOwner = address(0);\n    }\n}\n","id":0}}}
