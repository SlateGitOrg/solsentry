utability":"nonpayable","virtual":false,"visibility":"external"}],"scope":82,"src":"113:665:0","usedErrors":[],"usedEvents":[]}],"src":"87:692:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: role administration is owner-only.\npragma solidity ^0.8.20;\n\ncontract MinterRegistry {\n    address public owner;\n    mapping(address => bool) public minters;\n    mapping(address => uint256) public balanceOf;\n    uint256 public totalSupply;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    modifier onlyOwner() {\n        require(msg.sender == owner, \"owner\");\n        _;\n    }\n\n    modifier onlyMinter() {\n        require(minters[msg.sender], \"not minter\");\n        _;\n    }\n\n    function addMinter(address account) external onlyOwner {\n        minters[account] = true;\n    }\n\n    function mint(address to, uint256 amount) external onlyMinter {\n        balanceOf[to] += amount;\n        totalSupply += amount;\n    }\n}\n","id":0}}}
