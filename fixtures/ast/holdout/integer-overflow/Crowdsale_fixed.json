on":{"argumentTypes":[{"typeIdentifier":"t_bool","typeString":"bool"},{"typeIdentifier":"t_stringliteral_02016836a56b71f0d02689e69e326f4f4c1b9057164ef592671cf0d37c8040c0","typeString":"literal_string \"owner\""}],"id":97,"name":"require","nodeType":"Identifier","overloadedDeclarations":[-18,-18],"referencedDeclaration":-18,"src":"865:7:0","typeDescriptions":{"typeIdentifier":"t_function_require_pure$_t_bool_$_t_string_memory_ptr_$returns$__$","typeString":"function (bool,string memory) pure"}},"id":103,"isConstant":false,"isLValue":false,"isPure":false,"kind":"functionCall","lValueRequested":false,"names":[],"nodeType":"FunctionCall","src":"865:37:0","tryCall":false,"typeDescriptions":{"typeIdentifier":"t_tuple$__$","typeString":"tuple()"}},"id":104,"nodeType":"ExpressionStatement","src":"865:37:0"},{"expression":{"id":107,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"leftHandSide":{"id":105,"name":"rate","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":5,"src":"912:4:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"nodeType":"Assignment","operator":"=","rightHandSide":{"id":106,"name":"next","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":94,"src":"919:4:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"912:11:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"id":108,"nodeType":"ExpressionStatement","src":"912:11:0"}]},"functionSelector":"34fcf437","id":110,"implemented":true,"kind":"function","modifiers":[],"name":"setRate","nodeType":"FunctionDefinition","parameters":{"id":95,"nodeType":"ParameterList","parameters":[{"constant":false,"id":94,"mutability":"mutable","name":"next","nodeType":"VariableDeclaration","scope":110,"src":"832:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":93,"name":"uint256","nodeType":"ElementaryTypeName","src":"832:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"831:14:0"},"returnParameters":{"id":96,"nodeType":"ParameterList","parameters":[],"src":"855:0:0"},"scope":111,"src":"815:115:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":112,"src":"124:808:0"}],"src":"99:834:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: explicit overflow checks after each operation.\npragma solidity ^0.7.6;\n\ncontract Crowdsale {\n    address public owner;\n    uint256 public rate;\n    uint256 public totalSold;\n    mapping(address => uint256) public purchased;\n\n    constructor(uint256 tokensPerWei) {\n        owner = msg.sender;\n        rate = tokensPerWei;\n    }\n\n    function buy() external payable {\n        uint256 tokens = msg.value * rate;\n        require(msg.value == 0 || tokens / msg.value == rate, \"mul overflow\");\n        uint256 sold = totalSold + tokens;\n        require(sold >= totalSold, \"add overflow\");\n        totalSold = sold;\n        uint256 mine = purchased[msg.sender] + tokens;\n        require(mine >= tokens, \"add overflow\");\n        purchased[msg.sender] = mine;\n    }\n\n    function setRate(uint256 next) external {\n        require(msg.sender == owner, \"owner\");\n        rate = next;\n    }\n}\n","id":0}}}
