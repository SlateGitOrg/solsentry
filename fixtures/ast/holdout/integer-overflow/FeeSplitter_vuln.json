onstant":false,"id":39,"mutability":"mutable","name":"amount","nameLocation":"545:6:0","nodeType":"VariableDeclaration","scope":70,"src":"537:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":38,"name":"uint256","nodeType":"ElementaryTypeName","src":"537:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"509:43:0"},"returnParameters":{"id":41,"nodeType":"ParameterList","parameters":[],"src":"562:0:0"},"scope":71,"src":"494:268:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":72,"src":"150:614:0","usedErrors":[],"usedEvents":[]}],"src":"124:641:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture (intentionally vulnerable): gas-golfed fee math wraps for large amounts.\npragma solidity ^0.8.20;\n\ncontract FeeSplitter {\n    uint256 public constant FEE_BPS = 30;\n    mapping(address => uint256) public owed;\n\n    function quote(uint256 amount) public pure returns (uint256 fee, uint256 net) {\n        unchecked {\n            fee = (amount * FEE_BPS) / 10_000; // @expect: integer-overflow\n            net = amount - fee;\n        }\n    }\n\n    function settle(address[] calldata payees, uint256 amount) external {\n        (, uint256 net) = quote(amount);\n        for (uint256 i; i < payees.length; ) {\n            owed[payees[i]] += net;\n            unchecked {\n                ++i;\n            }\n        }\n    }\n}\n","id":0}}}
