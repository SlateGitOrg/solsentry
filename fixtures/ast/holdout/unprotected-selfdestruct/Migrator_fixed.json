npayable","virtual":false,"visibility":"internal"}],"scope":73,"src":"116:533:0","usedErrors":[],"usedEvents":[]}],"src":"90:560:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: the helper itself enforces ownership.\npragma solidity ^0.8.20;\n\ncontract Migrator {\n    address public owner;\n    address public successor;\n\n    constructor() {\n        owner = msg.sender;\n    }\n\n    function setSuccessor(address next) external {\n        require(msg.sender == owner, \"owner\");\n        successor = next;\n    }\n\n    function migrate() external {\n        require(successor != address(0), \"no successor\");\n        _destroy(payable(successor));\n    }\n\n    function _destroy(address payable to) internal {\n        require(msg.sender == owner, \"owner\");\n        selfdestruct(to);\n    }\n}\n","id":0}}}
