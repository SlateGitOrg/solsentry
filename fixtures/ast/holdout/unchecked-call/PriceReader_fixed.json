s":[],"name":"refresh","nameLocation":"287:7:0","nodeType":"FunctionDefinition","parameters":{"id":16,"nodeType":"ParameterList","parameters":[],"src":"294:2:0"},"returnParameters":{"id":17,"nodeType":"ParameterList","parameters":[],"src":"306:0:0"},"scope":52,"src":"278:237:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":53,"src":"117:400:0","usedErrors":[],"usedEvents":[]}],"src":"91:427:0"},"content":"// SPDX-License-Identifier: MIT\n// Holdout fixture: success and length are both validated.\npragma solidity ^0.8.20;\n\ncontract PriceReader {\n    address public oracle;\n    uint256 public lastPrice;\n\n    constructor(address priceOracle) {\n        oracle = priceOracle;\n    }\n\n    function refresh() external {\n        (bool ok, bytes memory data) = oracle.staticcall(abi.encodeWithSignature(\"price()\"));\n        require(ok && data.length == 32, \"oracle failed\");\n        lastPrice = abi.decode(data, (uint256));\n    }\n}\n","id":0}}}
