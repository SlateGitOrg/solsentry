:[],"src":"474:2:0"},"returnParameters":{"id":40,"nodeType":"ParameterList","parameters":[],"src":"494:0:0"},"scope":56,"src":"466:135:0","stateMutability":"payable","virtual":false,"visibility":"external"}],"scope":57,"src":"148:455:0","usedErrors":[],"usedEvents":[]}],"src":"122:482:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: a proxy delegating to a stored implementation that only the admin can change.\npragma solidity ^0.8.20;\n\ncontract Forwarder {\n    address public implementation;\n    address public admin;\n\n    constructor(address impl) {\n        implementation = impl;\n        admin = msg.sender;\n    }\n\n    function upgradeTo(address impl) external {\n        require(msg.sender == admin, \"admin\");\n        implementation = impl;\n    }\n\n    fallback() external payable {\n        (bool ok, ) = implementation.delegatecall(msg.data);\n        require(ok, \"forward failed\");\n    }\n}\n","id":0}}}
