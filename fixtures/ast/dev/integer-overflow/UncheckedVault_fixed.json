6","typeString":"uint256"},"typeName":{"id":41,"name":"uint256","nodeType":"ElementaryTypeName","src":"515:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"514:15:0"},"scope":68,"src":"445:254:0","stateMutability":"view","virtual":false,"visibility":"external"}],"scope":69,"src":"146:555:0","usedErrors":[],"usedEvents":[]}],"src":"120:582:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: checked arithmetic for user amounts; `unchecked` only for the loop counter.\npragma solidity ^0.8.20;\n\ncontract UncheckedVault {\n    mapping(address => uint256) public shares;\n    uint256 public totalShares;\n\n    function mintShares(address to, uint256 amount) external {\n        require(msg.sender == address(0x1234), \"minter\");\n        shares[to] += amount;\n        totalShares += amount;\n    }\n\n    function sumShares(address[] calldata holders) external view returns (uint256 total) {\n        for (uint256 i = 0; i < holders.length; ) {\n            total += shares[holders[i]];\n            unchecked {\n                ++i;\n            }\n        }\n    }\n}\n","id":0}}}
