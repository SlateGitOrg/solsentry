256 supply) {\n        balanceOf[msg.sender] = supply;\n        totalSupply = supply;\n    }\n\n    function transfer(address to, uint256 amount) external returns (bool) {\n        balanceOf[msg.sender] -= amount; // @expect: integer-overflow\n        balanceOf[to] += amount; // @expect: integer-overflow\n        return true;\n    }\n}\n","id":0}}}
