rageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":54,"name":"address","nodeType":"ElementaryTypeName","src":"653:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"652:14:0"},"returnParameters":{"id":59,"nodeType":"ParameterList","parameters":[],"src":"686:0:0"},"scope":66,"src":"635:80:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":67,"src":"207:510:0","usedErrors":[],"usedEvents":[]}],"src":"181:537:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: msg.sender in the modifier; the tx.origin == msg.sender \"no contracts\" idiom is\n// not an authentication check and must not be reported.\npragma solidity ^0.8.20;\n\ncontract OriginModifier {\n    address public admin;\n    uint256 public fee;\n\n    constructor() {\n        admin = msg.sender;\n    }\n\n    modifier onlyAdmin() {\n        require(msg.sender == admin, \"admin only\");\n        _;\n    }\n\n    modifier onlyEOA() {\n        require(tx.origin == msg.sender, \"no contracts\");\n        _;\n    }\n\n    function setFee(uint256 newFee) external onlyAdmin onlyEOA {\n        fee = newFee;\n    }\n\n    function setAdmin(address next) external onlyAdmin {\n        admin = next;\n    }\n}\n","id":0}}}
