ert {\n    error Unauthorized();\n\n    mapping(address => bool) public operators;\n    uint256 public price;\n\n    constructor() {\n        operators[msg.sender] = true;\n    }\n\n    function setPrice(uint256 newPrice) external {\n        if (!operators[msg.sender]) revert Unauthorized();\n        price = newPrice;\n    }\n}\n","id":0}}}
