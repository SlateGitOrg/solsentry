Type":"ParameterList","parameters":[{"constant":false,"id":51,"mutability":"mutable","name":"randomness","nameLocation":"637:10:0","nodeType":"VariableDeclaration","scope":74,"src":"629:18:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":50,"name":"uint256","nodeType":"ElementaryTypeName","src":"629:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"628:20:0"},"returnParameters":{"id":53,"nodeType":"ParameterList","parameters":[],"src":"658:0:0"},"scope":75,"src":"612:188:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":76,"src":"143:659:0","usedErrors":[],"usedEvents":[]}],"src":"117:686:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: randomness supplied by a trusted oracle; block numbers rate-limit spins.\npragma solidity ^0.8.20;\n\ncontract Roulette {\n    address public lastWinner;\n    address public oracle;\n    uint256 public lastSpinBlock;\n    address public pendingPlayer;\n\n    constructor(address randomnessOracle) {\n        oracle = randomnessOracle;\n    }\n\n    function spin() external payable {\n        require(msg.value == 1 ether, \"stake\");\n        require(block.number > lastSpinBlock, \"one per block\");\n        lastSpinBlock = block.number;\n        pendingPlayer = msg.sender;\n    }\n\n    function fulfill(uint256 randomness) external {\n        require(msg.sender == oracle, \"oracle\");\n        if (randomness % 15 == 0) {\n            lastWinner = pendingPlayer;\n        }\n    }\n}\n","id":0}}}
