deType":"ParameterList","parameters":[],"src":"346:0:0"},"scope":46,"src":"318:159:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":47,"src":"122:357:0","usedErrors":[],"usedEvents":[]}],"src":"96:384:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: a range comparison tolerates validator clock drift.\npragma solidity ^0.8.20;\n\ncontract TimeLock {\n    uint256 public releaseTime;\n    address public beneficiary;\n\n    constructor(address who, uint256 when) {\n        beneficiary = who;\n        releaseTime = when;\n    }\n\n    function release() external {\n        require(block.timestamp >= releaseTime, \"too early\");\n        payable(beneficiary).transfer(address(this).balance);\n    }\n}\n","id":0}}}
