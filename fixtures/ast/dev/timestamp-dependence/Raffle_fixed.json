:0","typeDescriptions":{"typeIdentifier":"t_array$_t_address_$dyn_storage","typeString":"address[] storage ref"}},"id":96,"isConstant":false,"isLValue":false,"isPure":false,"lValueRequested":false,"memberLocation":"980:6:0","memberName":"length","nodeType":"MemberAccess","src":"972:14:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"src":"965:21:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"nodeType":"IndexAccess","src":"957:30:0","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"src":"948:39:0","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"id":100,"nodeType":"ExpressionStatement","src":"948:39:0"}]},"functionSelector":"a49feb0d","id":102,"implemented":true,"kind":"function","modifiers":[],"name":"fulfillRandomWord","nameLocation":"785:17:0","nodeType":"FunctionDefinition","parameters":{"id":74,"nodeType":"ParameterList","parameters":[{"constant":false,"id":73,"mutability":"mutable","name":"word","nameLocation":"811:4:0","nodeType":"VariableDeclaration","scope":102,"src":"803:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":72,"name":"uint256","nodeType":"ElementaryTypeName","src":"803:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"802:14:0"},"returnParameters":{"id":75,"nodeType":"ParameterList","parameters":[],"src":"826:0:0"},"scope":103,"src":"776:218:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":104,"src":"181:815:0","usedErrors":[],"usedEvents":[]}],"src":"155:842:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: timestamps only bound the entry window and label tickets; the draw uses an\n// externally supplied random word.\npragma solidity ^0.8.20;\n\ncontract Raffle {\n    address[] public players;\n    address public winner;\n    address public coordinator;\n    uint256 public endTime;\n    mapping(bytes32 => address) public tickets;\n\n    constructor(uint256 duration, address vrfCoordinator) {\n        endTime = block.timestamp + duration;\n        coordinator = vrfCoordinator;\n    }\n\n    function enter() external payable {\n        require(block.timestamp < endTime, \"closed\");\n        bytes32 ticket = keccak256(abi.encodePacked(msg.sender, block.timestamp));\n        tickets[ticket] = msg.sender;\n        players.push(msg.sender);\n    }\n\n    function fulfillRandomWord(uint256 word) external {\n        require(msg.sender == coordinator, \"coordinator\");\n        require(block.timestamp >= endTime, \"open\");\n        winner = players[word % players.length];\n    }\n}\n","id":0}}}
