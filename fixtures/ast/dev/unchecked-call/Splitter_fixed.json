:22,"nodeType":"ParameterList","parameters":[],"src":"323:2:0"},"returnParameters":{"id":23,"nodeType":"ParameterList","parameters":[],"src":"335:0:0"},"scope":69,"src":"309:248:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"body":{"id":67,"nodeType":"Block","src":"590:2:0","statements":[]},"id":68,"implemented":true,"kind":"receive","modifiers":[],"name":"","nameLocation":"-1:-1:-1","nodeType":"FunctionDefinition","parameters":{"id":65,"nodeType":"ParameterList","parameters":[],"src":"570:2:0"},"returnParameters":{"id":66,"nodeType":"ParameterList","parameters":[],"src":"590:0:0"},"scope":69,"src":"563:29:0","stateMutability":"payable","virtual":false,"visibility":"external"}],"scope":70,"src":"113:481:0","usedErrors":[],"usedEvents":[]}],"src":"87:508:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: the flag reaches a require through a copy.\npragma solidity ^0.8.20;\n\ncontract Splitter {\n    address payable public a;\n    address payable public b;\n\n    constructor(address payable first, address payable second) {\n        a = first;\n        b = second;\n    }\n\n    function split() external {\n        uint256 half = address(this).balance / 2;\n        bool sentA = a.send(half);\n        bool both = sentA;\n        bool sentB = b.send(half);\n        both = both && sentB;\n        require(both, \"send failed\");\n    }\n\n    receive() external payable {}\n}\n","id":0}}}
