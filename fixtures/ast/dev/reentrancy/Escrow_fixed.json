"ElementaryTypeName","src":"1047:15:0","stateMutability":"payable","typeDescriptions":{"typeIdentifier":"t_address_payable","typeString":"address payable"}},"visibility":"internal"},{"constant":false,"id":116,"mutability":"mutable","name":"amount","nameLocation":"1075:6:0","nodeType":"VariableDeclaration","scope":134,"src":"1067:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":115,"name":"uint256","nodeType":"ElementaryTypeName","src":"1067:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"1046:36:0"},"returnParameters":{"id":118,"nodeType":"ParameterList","parameters":[],"src":"1092:0:0"},"scope":135,"src":"1033:151:0","stateMutability":"nonpayable","virtual":false,"visibility":"internal"}],"scope":136,"src":"147:1039:0","usedErrors":[10],"usedEvents":[]}],"src":"121:1066:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: OpenZeppelin 5.x style guard implemented with internal before/after helpers.\npragma solidity ^0.8.20;\n\ncontract Escrow {\n    struct Deal {\n        address payable seller;\n        uint256 amount;\n        bool released;\n    }\n\n    error ReentrantCall();\n\n    mapping(uint256 => Deal) public deals;\n    uint256 public nextId;\n    uint256 private _guard = 1;\n\n    modifier nonReentrant() {\n        _enter();\n        _;\n        _leave();\n    }\n\n    function _enter() private {\n        if (_guard == 2) revert ReentrantCall();\n        _guard = 2;\n    }\n\n    function _leave() private {\n        _guard = 1;\n    }\n\n    function open(address payable seller) external payable returns (uint256 id) {\n        id = nextId++;\n        deals[id] = Deal(seller, msg.value, false);\n    }\n\n    function release(uint256 id) external nonReentrant {\n        Deal storage deal = deals[id];\n        require(!deal.released, \"done\");\n        _pay(deal.seller, deal.amount);\n        deal.released = true;\n    }\n\n    function _pay(address payable to, uint256 amount) internal {\n        (bool ok, ) = to.call{value: amount}(\"\");\n        require(ok, \"pay failed\");\n    }\n}\n","id":0}}}
