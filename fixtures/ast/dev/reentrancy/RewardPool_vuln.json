al\");\n        credits[user] += amount;\n    }\n\n    function claim() external {\n        uint256 amount = credits[msg.sender];\n        IRewardReceiver(msg.sender).onReward(amount); // @expect: reentrancy\n        credits[msg.sender] = 0;\n        totalPaid += amount;\n    }\n\n    function pending(address user) external view returns (uint256) {\n        return credits[user];\n    }\n}\n","id":0}}}
