ameters":[],"src":"695:0:0"},"scope":105,"src":"656:208:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"},{"body":{"id":103,"nodeType":"Block","src":"933:37:0","statements":[{"expression":{"baseExpression":{"id":99,"name":"credits","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":11,"src":"950:7:0","typeDescriptions":{"typeIdentifier":"t_mapping$_t_address_$_t_uint256_$","typeString":"mapping(address => uint256)"}},"id":101,"indexExpression":{"id":100,"name":"user","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":94,"src":"958:4:0","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"isConstant":false,"isLValue":true,"isPure":false,"lValueRequested":false,"nodeType":"IndexAccess","src":"950:13:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"functionReturnParameters":98,"id":102,"nodeType":"Return","src":"943:20:0"}]},"functionSelector":"5eebea20","id":104,"implemented":true,"kind":"function","modifiers":[],"name":"pending","nameLocation":"879:7:0","nodeType":"FunctionDefinition","parameters":{"id":95,"nodeType":"ParameterList","parameters":[{"constant":false,"id":94,"mutability":"mutable","name":"user","nameLocation":"895:4:0","nodeType":"VariableDeclaration","scope":104,"src":"887:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":93,"name":"address","nodeType":"ElementaryTypeName","src":"887:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"}],"src":"886:14:0"},"returnParameters":{"id":98,"nodeType":"ParameterList","parameters":[{"constant":false,"id":97,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":104,"src":"924:7:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":96,"name":"uint256","nodeType":"ElementaryTypeName","src":"924:7:0","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"}],"src":"923:9:0"},"scope":105,"src":"870:100:0","stateMutability":"view","virtual":false,"visibility":"external"}],"scope":106,"src":"220:752:0","usedErrors":[],"usedEvents":[]}],"src":"115:858:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: an inline mutex modifier (OpenZeppelin 4.x style) guards the callback.\npragma solidity ^0.8.20;\n\ninterface IRewardReceiver {\n    function onReward(uint256 amount) external;\n}\n\ncontract RewardPool {\n    mapping(address => uint256) public credits;\n    uint256 public totalPaid;\n    uint256 private _status = 1;\n\n    modifier nonReentrant() {\n        require(_status != 2, \"reentrant call\");\n        _status = 2;\n        _;\n        _status = 1;\n    }\n\n    function credit(address user, uint256 amount) external {\n        require(msg.sender == address(this), \"internal\");\n        credits[user] += amount;\n    }\n\n    function claim() external nonReentrant {\n        uint256 amount = credits[msg.sender];\n        IRewardReceiver(msg.sender).onReward(amount);\n        credits[msg.sender] = 0;\n        totalPaid += amount;\n    }\n\n    function pending(address user) external view returns (uint256) {\n        return credits[user];\n    }\n}\n","id":0}}}
