,"typeDescriptions":{"typeIdentifier":"t_address_payable","typeString":"address payable"}},"visibility":"internal"}],"src":"753:20:0"},"returnParameters":{"id":66,"nodeType":"ParameterList","parameters":[],"src":"793:0:0"},"scope":79,"src":"739:105:0","stateMutability":"nonpayable","virtual":false,"visibility":"external"}],"scope":80,"src":"134:712:0","usedErrors":[5],"usedEvents":[]}],"src":"108:739:0"},"content":"// SPDX-License-Identifier: MIT\n// Fixture: OpenZeppelin 5.x style `_checkOwner()` helper guards the sweep.\npragma solidity ^0.8.20;\n\ncontract Treasury {\n    error OwnableUnauthorizedAccount(address account);\n\n    address private _owner;\n\n    constructor() {\n        _owner = msg.sender;\n    }\n\n    receive() external payable {}\n\n    modifier onlyOwner() {\n        _checkOwner();\n        _;\n    }\n\n    function owner() public view returns (address) {\n        return _owner;\n    }\n\n    function _msgSender() internal view returns (address) {\n        return msg.sender;\n    }\n\n    function _checkOwner() internal view {\n        if (owner() != _msgSender()) {\n            revert OwnableUnauthorizedAccount(_msgSender());\n        }\n    }\n\n    function sweep(address payable to) external onlyOwner {\n        to.transfer(address(this).balance);\n    }\n}\n","id":0}}}
